# ============================================================
# Ultra Mobile Admin — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ------------------------------------------------------------
# Firebase Client SDK (public — safe to expose in browser)
# These match your ultra-mobile-652ff project exactly.
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDz9HwCuzvv8q9zQbxIPPvZ14nHQEQUKI0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ultra-mobile-652ff.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ultra-mobile-652ff
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ultra-mobile-652ff.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=595013417103
NEXT_PUBLIC_FIREBASE_APP_ID=1:595013417103:android:c396c877461bb43aa298fa

# ------------------------------------------------------------
# Firebase Admin SDK (server-side only — KEEP SECRET)
# Option 1: Path to service account JSON file (local dev)
#   Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Save as service-account.json in the project root (it is gitignored).
# Option 2: Set the JSON content as an env var (production/Vercel)
# ------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"ultra-mobile-652ff",...}

# ------------------------------------------------------------
# Seed Admin Secret
# Used to protect the /api/seed-admin endpoint.
# Change this to something random before deploying.
# ------------------------------------------------------------
SEED_SECRET=ultra-mobile-seed-change-me

# ------------------------------------------------------------
# App URL (used for CORS and redirects in production)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
